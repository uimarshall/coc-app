# ──────────────────────────────────────────────────────
# .gitignore — files and folders that should NEVER be
# committed to Git (secrets, generated files, etc.)
# ──────────────────────────────────────────────────────

# ── Environment files (CRITICAL — never commit secrets!) ──
.env
.env.local
.env.*.local
.env.production

# ── Node.js dependencies ──────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js build output ──────────────────────────────────
.next/
out/

# ── Testing artifacts ─────────────────────────────────────
coverage/
playwright-report/
test-results/
.playwright/

# ── Production build ──────────────────────────────────────
build/
dist/

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── macOS ─────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Linux ─────────────────────────────────────────────────
*~

# ── Editors ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Drizzle ───────────────────────────────────────────────
# Uncomment if you prefer not to commit migrations to Git
# db/migrations/
