# =============================================================================
# Environment Variables — Church of Christ Huddersfield App
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in your actual values in .env.local
#   3. NEVER commit .env.local or .env to Git — it contains secrets!
#
# For production (VPS), create a .env file in /opt/coc-app/ on the server.
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================

# Your Neon PostgreSQL connection string.
# Get it from: https://neon.tech → Your project → Connection Details
# The URL format is:  ******host/dbname?sslmode=require
DATABASE_URL="<paste-your-neon-connection-string-here>"


# =============================================================================
# BETTER AUTH
# =============================================================================

# Secret key used to sign and verify session tokens.
# MUST be at least 32 characters long. Keep this secret — if it leaks,
# attackers can forge login sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-min-32-characters"

# The full public URL of your application (no trailing slash).
# In development: http://localhost:3000
# In production:  https://yourchurch.com
BETTER_AUTH_URL="http://localhost:3000"


# =============================================================================
# NEXT.JS PUBLIC VARIABLES
# These are safe to expose to the browser (they are included in the JS bundle).
# Never put secret keys here.
# =============================================================================

# Same as BETTER_AUTH_URL — the public URL of your app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# =============================================================================
# PRODUCTION ONLY (uncomment and fill in when deploying)
# =============================================================================

# The domain name of your website (used by Nginx and SSL certificates)
# DOMAIN="yourchurch.com"
